# Prod VMs built from template 9000 (prdsrv1, prdsrv4 onwards), listed in vms.auto.tfvars.
# prdsrv2 is hand-built and stays in prod.tf; prdsrv3 is a container (containers.tf).

locals {
  prod_node_names = {
    prx1 = "prx-server-1"
    prx2 = "prx-server-2"
  }

  prod_ssh_keys = [trimspace(file(pathexpand(var.ssh_public_key_file)))]

  # Both Pi-holes: prdsrv2's, then prdsrv3's, so names still resolve while prdsrv2 is down.
  prod_dns_servers = ["10.69.20.114", "10.69.20.115"]
}

# Providers can't be picked per for_each item, so one module block per host.
module "prod_vm_prx1" {
  source    = "../../modules/prod-vm"
  providers = { proxmox = proxmox.prx1 }
  for_each  = { for k, v in var.prod_vms : k => v if v.node == "prx1" }

  name            = each.key
  node_name       = local.prod_node_names.prx1
  datastore_id    = "data"
  vm_id           = each.value.vmid
  cores           = each.value.cores
  memory_mb       = each.value.memory_mb
  disk_gb         = each.value.disk_gb
  tags            = concat(["prod", "linux"], each.value.tags)
  ipv4_address    = "${each.value.ip}/24"
  ssh_public_keys = local.prod_ssh_keys
  dns_servers     = local.prod_dns_servers
  on_boot         = true
}

module "prod_vm_prx2" {
  source    = "../../modules/prod-vm"
  providers = { proxmox = proxmox.prx2 }
  for_each  = { for k, v in var.prod_vms : k => v if v.node == "prx2" }

  name            = each.key
  node_name       = local.prod_node_names.prx2
  datastore_id    = "data"
  vm_id           = each.value.vmid
  cores           = each.value.cores
  memory_mb       = each.value.memory_mb
  disk_gb         = each.value.disk_gb
  tags            = concat(["prod", "linux"], each.value.tags)
  ipv4_address    = "${each.value.ip}/24"
  ssh_public_keys = local.prod_ssh_keys
  dns_servers     = local.prod_dns_servers
  on_boot         = true
}

output "vms" {
  description = "Prod VMs built from the template (prdsrv2 is in prod.tf)"
  value = {
    for name, vm in merge(module.prod_vm_prx1, module.prod_vm_prx2) :
    name => "${vm.node_name}  vmid=${vm.vm_id}  ip=${vm.ipv4}  ssh turbx@${vm.ipv4}"
  }
}

# SSH config for these VMs and prdsrv3 (git-ignored; regenerated on every apply). ~/.ssh/config
# includes ssh/*.generated.conf before its own hosts, so `ssh prdsrv1` works as soon as the VM
# exists. prdsrv2 is in the dotfiles SSH config itself.
resource "local_file" "ssh_config" {
  filename        = "${path.root}/../../../ssh/prod.generated.conf"
  file_permission = "0644"
  content = join("\n", concat(
    ["# Generated by Terraform (terraform/envs/prod). Do not edit: rewritten on every make up."],
    [for name, ip in merge(
      { for name, vm in merge(module.prod_vm_prx1, module.prod_vm_prx2) : name => vm.ipv4 },
      { prdsrv3 = split("/", proxmox_virtual_environment_container.prdsrv3.initialization[0].ip_config[0].ipv4[0].address)[0] },
      ) : <<-EOT

      Host ${name}
        HostName ${ip}
        User turbx
        IdentityFile ~/.ssh/id_ed25519_homelab
        IdentitiesOnly yes
    EOT
  ]))
}
